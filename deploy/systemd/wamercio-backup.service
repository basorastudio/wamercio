[Unit]
Description=WAMERCIO PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=WAMERCIO_PROJECT_DIR=/opt/wamercio
Environment=WAMERCIO_BACKUP_ROOT=/opt/wamercio_backups
ExecStart=/opt/wamercio/scripts/backup/create-backup.sh
ExecStartPost=/opt/wamercio/scripts/backup/verify-backup.sh /opt/wamercio_backups/latest
ExecStartPost=/opt/wamercio/scripts/backup/retention.sh
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
