# ==============================================================
# wamercio — PRODUCCIÓN / DOKPLOY
# Sustituye TODOS los valores CAMBIAR_* y REEMPLAZAR_*.
# Ejemplo de dominio: wamercio.com
# ==============================================================
APP_NAME=wamercio
APP_ENV=production
TZ=America/Santo_Domingo
ROOT_DOMAIN=wamercio.com
APP_URL=https://wamercio.com

POSTGRES_DB=wamercio
POSTGRES_USER=wamercio
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_MUY_SEGURO
DATABASE_URL=postgres://wamercio:CAMBIAR_PASSWORD_POSTGRES_MUY_SEGURO@postgres:5432/wamercio?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CAMBIAR_JWT_SECRET_ALEATORIO_MINIMO_32_CARACTERES
JWT_TTL_MINUTES=480
COOKIE_SECURE=true

API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_APP_NAME=wamercio
NEXT_PUBLIC_ROOT_DOMAIN=wamercio.com
MEDIA_DIR=/data/uploads

# En producción, no crear datos demo.
SEED_DEMO=false
SUPERADMIN_EMAIL=admin@wamercio.com
SUPERADMIN_PASSWORD=CAMBIAR_PASSWORD_SUPERADMIN_MUY_SEGURO
DEMO_ADMIN_EMAIL=demo@wamercio.com
DEMO_ADMIN_PASSWORD=CAMBIAR_PASSWORD_DEMO_O_DEJAR_NO_USADO

# Waxum
WAXUM_BASE_URL=https://waxum.ltd.do
WAXUM_SUPERADMIN_TOKEN=REEMPLAZAR_CON_TOKEN_WAXUM
WAXUM_WEBHOOK_BASE_URL=https://wamercio.com/api/backend/api/v1/public/webhooks/waxum

# Identidad Dominicana
IDENTITY_BASE_URL=https://id.ltd.do
IDENTITY_API_KEY=REEMPLAZAR_CON_API_KEY_IDENTIDAD
IDENTITY_CLIENT_ID=wamercio
IDENTITY_APPLICATION_DOMAIN=wamercio.com
IDENTITY_HASH_SECRET=CAMBIAR_SECRETO_HMAC_IDENTIDAD_INDEPENDIENTE
IDENTITY_OWNER_CONTEXT=registro_propietario
IDENTITY_BUSINESS_CONTEXT=registro_negocio
IDENTITY_CUSTOMER_CONTEXT=registro_cliente
IDENTITY_PUBLIC_RATE_LIMIT=8

# GEO RD MAP
GEO_RD_MAP_BASE_URL=https://geo.ltd.do
GEO_RD_MAP_API_KEY=REEMPLAZAR_CON_API_KEY_GEO_RD_MAP
GEO_RD_MAP_PUBLIC_RATE_LIMIT=60
