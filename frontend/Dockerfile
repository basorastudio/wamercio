# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS build

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NPM_CONFIG_REGISTRY=https://registry.npmjs.org/ \
    NPM_CONFIG_REPLACE_REGISTRY_HOST=always \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_PROGRESS=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FETCH_RETRIES=6 \
    NPM_CONFIG_FETCH_RETRY_FACTOR=2 \
    NPM_CONFIG_FETCH_RETRY_MINTIMEOUT=10000 \
    NPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=60000 \
    NPM_CONFIG_MAXSOCKETS=8 \
    NPM_INSTALL_TIMEOUT_SECONDS=600

COPY package.json package-lock.json .npmrc ./
COPY scripts/install-dependencies.sh ./scripts/install-dependencies.sh
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    sh ./scripts/install-dependencies.sh

COPY . .

ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_ADMIN_USERNAME=
ARG NEXT_PUBLIC_PLATFORM_ADMIN_USERNAME=superadmin
ARG NEXT_PUBLIC_PLATFORM_DOMAIN=wamercio.com
ARG NEXT_PUBLIC_PLATFORM_HOST_ALIASES=
ARG NEXT_PUBLIC_ROOT_DOMAIN=ltd.do
ARG NEXT_PUBLIC_APP_TIMEZONE=America/Santo_Domingo
ARG NEXT_PUBLIC_CATALOG_IMAGE_BASE_URL=https://catalogo.ltd.do

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_ADMIN_USERNAME=$NEXT_PUBLIC_ADMIN_USERNAME \
    NEXT_PUBLIC_PLATFORM_ADMIN_USERNAME=$NEXT_PUBLIC_PLATFORM_ADMIN_USERNAME \
    NEXT_PUBLIC_PLATFORM_DOMAIN=$NEXT_PUBLIC_PLATFORM_DOMAIN \
    NEXT_PUBLIC_PLATFORM_HOST_ALIASES=$NEXT_PUBLIC_PLATFORM_HOST_ALIASES \
    NEXT_PUBLIC_ROOT_DOMAIN=$NEXT_PUBLIC_ROOT_DOMAIN \
    NEXT_PUBLIC_APP_TIMEZONE=$NEXT_PUBLIC_APP_TIMEZONE \
    NEXT_PUBLIC_CATALOG_IMAGE_BASE_URL=$NEXT_PUBLIC_CATALOG_IMAGE_BASE_URL \
    NODE_ENV=production

RUN test ! -d src/pages
RUN npm run typecheck && npm run build

FROM nginx:1.27-alpine

RUN apk add --no-cache tzdata
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 80
