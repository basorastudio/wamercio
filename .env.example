# ==============================================================
# wamercio — PLANTILLA DE CONFIGURACIÓN
# Copia este archivo a .env para desarrollo.
# Para Dokploy usa .env.dokploy.example como base.
# ==============================================================
APP_NAME=wamercio
APP_ENV=development
TZ=America/Santo_Domingo
ROOT_DOMAIN=localhost
APP_URL=http://localhost:3000

POSTGRES_DB=wamercio
POSTGRES_USER=wamercio
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_PASSWORD
DATABASE_URL=postgres://wamercio:CAMBIAR_POSTGRES_PASSWORD@postgres:5432/wamercio?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CAMBIAR_POR_SECRETO_DE_32_CARACTERES_O_MAS
JWT_TTL_MINUTES=480
COOKIE_SECURE=false

API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_APP_NAME=wamercio
NEXT_PUBLIC_ROOT_DOMAIN=localhost
MEDIA_DIR=/data/uploads

SEED_DEMO=true
SUPERADMIN_EMAIL=admin@wamercio.local
SUPERADMIN_PASSWORD=CAMBIAR_PASSWORD_SUPERADMIN
DEMO_ADMIN_EMAIL=demo@wamercio.local
DEMO_ADMIN_PASSWORD=CAMBIAR_PASSWORD_DEMO

WAXUM_BASE_URL=https://waxum.ltd.do
WAXUM_SUPERADMIN_TOKEN=REEMPLAZAR_CON_TOKEN_WAXUM
WAXUM_WEBHOOK_BASE_URL=http://localhost:3000/api/backend/api/v1/public/webhooks/waxum

IDENTITY_BASE_URL=https://id.ltd.do
IDENTITY_API_KEY=REEMPLAZAR_CON_API_KEY_IDENTIDAD
IDENTITY_CLIENT_ID=wamercio
IDENTITY_APPLICATION_DOMAIN=localhost
IDENTITY_HASH_SECRET=CAMBIAR_POR_SECRETO_HMAC_INDEPENDIENTE
IDENTITY_OWNER_CONTEXT=registro_propietario
IDENTITY_BUSINESS_CONTEXT=registro_negocio
IDENTITY_CUSTOMER_CONTEXT=registro_cliente
IDENTITY_PUBLIC_RATE_LIMIT=8

GEO_RD_MAP_BASE_URL=https://geo.ltd.do
GEO_RD_MAP_API_KEY=REEMPLAZAR_CON_API_KEY_GEO_RD_MAP
GEO_RD_MAP_PUBLIC_RATE_LIMIT=60
