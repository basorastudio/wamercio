APP_PORT=80
APP_DOMAIN=wamercio.com
ROOT_DOMAIN=ltd.do
DOKPLOY_PANEL_DOMAIN=proyecto.ltd.do
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_NAME=
DEFAULT_TENANT_DOMAIN=
APP_PUBLIC_URL=https://wamercio.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_PLATFORM_ADMIN_USERNAME=superadmin
NEXT_PUBLIC_PLATFORM_DOMAIN=wamercio.com
NEXT_PUBLIC_PLATFORM_HOST_ALIASES=
NEXT_PUBLIC_ROOT_DOMAIN=ltd.do
NEXT_PUBLIC_APP_TIMEZONE=America/Santo_Domingo
NEXT_PUBLIC_CATALOG_IMAGE_BASE_URL=https://catalogo.ltd.do
CLOUDFLARE_FLEXIBLE=false
TZ=America/Santo_Domingo
APP_TIMEZONE=America/Santo_Domingo

POSTGRES_DB=colmapro_core
POSTGRES_USER=colmapro
POSTGRES_PASSWORD=change_this_secure_password

APP_ENV=production
APP_NAME=WAMERCIO
APP_VERSION=development
HTTP_ADDR=:8080
INTERNAL_ADDR=127.0.0.1:6060
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=10m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_REQUEST_TIMEOUT=30s
HTTP_EXTERNAL_REQUEST_TIMEOUT=10m
HTTP_PROVISIONING_REQUEST_TIMEOUT=10m
DATABASE_MIGRATION_TIMEOUT=15m
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_JSON_BODY_BYTES=2097152
CENTRAL_DATABASE_URL=postgres://colmapro:change_this_secure_password@postgres:5432/colmapro_core?sslmode=disable
GLOBAL_CUSTOMERS_DATABASE_NAME=colmapro_global_customers
GLOBAL_CUSTOMERS_DATABASE_URL=postgres://colmapro:change_this_secure_password@postgres:5432/colmapro_global_customers?sslmode=disable
TENANT_DATABASE_URL_TEMPLATE=postgres://colmapro:change_this_secure_password@postgres:5432/{{database}}?sslmode=disable
# Optional override; when empty, the runtime URL is derived from the tenant
# template and PGBOUNCER_ADDR.
RUNTIME_TENANT_DATABASE_URL_TEMPLATE=
TENANT_DATABASE_PREFIX=cp_
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
RUN_MIGRATIONS=true
CORE_MIGRATIONS_PATH=file://db/core_migrations
GLOBAL_CUSTOMER_MIGRATIONS_PATH=file://db/global_customer_migrations
TENANT_MIGRATIONS_PATH=file://db/tenant_migrations

ADMIN_USERNAME=
ADMIN_PASSWORD_SHA256=
ADMIN_TOKEN_SECRET=change_this_secret
PLATFORM_ADMIN_USERNAME=superadmin
# Generate this value with: printf '%s' 'your_password' | sha256sum | awk '{print $1}'
PLATFORM_ADMIN_PASSWORD_SHA256=
PLATFORM_ADMIN_SECRET=change_this_secret
PLATFORM_TOKEN_SECRET=change_this_secret

TERRITORY_DATA_DIR=/app/data

# GEO RD MAP — división territorial centralizada (solo backend; nunca NEXT_PUBLIC_*)
GEO_RD_MAP_ENABLED=false
GEO_RD_MAP_URL=https://geo.ltd.do
GEO_RD_MAP_API_KEY=
GEO_RD_MAP_TIMEOUT=12s

CATALOG_DATA_FILE=/app/data/catalog.json

# Cloudflare R2 configuration for replacing global catalog images without changing public URLs
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# =============================================================================
# WAMERCIO CONSERVATIVE CAPACITY BUDGETS
# The helper copies explicit values to .env.auto; it does not grow database
# pools from host CPU or RAM. Recalculate the global budget before scaling.
# =============================================================================
AUTOTUNE_ENABLED=true
# Informational values are generated in .env.auto. Keep zero when the helper
# should report the detected host capacity.
AUTOTUNE_CPU_CORES=0
AUTOTUNE_RAM_MB=0
AUTOTUNE_RAM_GB=0
AUTOTUNE_DISK_GB=0
BACKEND_CPUS=2.0
BACKEND_MEMORY_LIMIT=1536m
BACKEND_GOMEMLIMIT=1380MiB
BACKEND_GOGC=100
PG_MAX_CONNECTIONS=80
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=256MB
CENTRAL_DB_MIN_CONNS=1
CENTRAL_DB_MAX_CONNS=8
GLOBAL_CUSTOMERS_DB_MIN_CONNS=1
GLOBAL_CUSTOMERS_DB_MAX_CONNS=8
TENANT_DB_MIN_CONNS=0
TENANT_DB_MAX_CONNS=2
TENANT_DB_MAX_IDLE_TIME=5m
TENANT_DB_MAX_LIFETIME=30m
TENANT_POOL_TTL_MINUTES=5
MAX_ACTIVE_TENANT_POOLS=20
USE_PGBOUNCER=true
PGBOUNCER_ADDR=pgbouncer:6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=2
PGBOUNCER_RESERVE_POOL_SIZE=1
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
REDIS_OPERATION_TIMEOUT=300ms
BOOTSTRAP_REFETCH_MS=30000
CLIENT_SESSION_REFRESH_MS=30000
CLIENT_CART_PULL_MS=15000
ENABLE_REALTIME_EVENTS=true
SSE_HEARTBEAT_INTERVAL=25s
SSE_WRITE_TIMEOUT=10s
SSE_CLIENT_QUEUE_SIZE=32
SSE_REPLAY_SIZE=128
SSE_REPLAY_TENANT_LIMIT=1000
SSE_MAX_CONNECTIONS_TOTAL=5000
SSE_MAX_CONNECTIONS_PER_TENANT=1000
SSE_MAX_CONNECTIONS_PER_CLIENT=50
SSE_REDIS_CHANNEL=colmapro:realtime:events
MAX_REQUESTS_PER_MINUTE_PER_TENANT=720
MAX_REQUESTS_PER_MINUTE_PER_IP=180
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
AUTH_FAILURE_LIMIT=5
AUTH_LOCKOUT=15m
DB_CONNECT_TIMEOUT=5s
DB_SLOW_QUERY_THRESHOLD=500ms
MIGRATION_MAX_CONCURRENCY=2
CENTRAL_DB_STATEMENT_TIMEOUT=30s
CENTRAL_DB_LOCK_TIMEOUT=5s
GLOBAL_CUSTOMERS_DB_STATEMENT_TIMEOUT=30s
TENANT_DB_STATEMENT_TIMEOUT=30s
ORDER_TRANSACTION_TIMEOUT=5s
R2_HTTP_TIMEOUT=45s
WAXUM_HTTP_TIMEOUT=25s
ROUTING_SERVICE_URL=https://router.project-osrm.org
ROUTING_HTTP_TIMEOUT=6s

# Scheduled production backups
COLMAPRO_BACKUP_ROOT=/opt/colmapro_backups
COLMAPRO_BACKUP_DAILY_DAYS=7
COLMAPRO_BACKUP_WEEKLY_WEEKS=5
COLMAPRO_BACKUP_MONTHLY_MONTHS=12
# Required only for an explicitly confirmed restore.
COLMAPRO_RESTORE_CONFIRM=
COLMAPRO_RESTORE_GLOBALS=false
# =============================================================================
# IDENTIDAD API (server-to-server; never expose the API key in NEXT_PUBLIC_*)
# =============================================================================
IDENTIDAD_API_ENABLED=false
IDENTIDAD_API_REQUIRED=false
IDENTIDAD_API_URL=https://id.ltd.do
IDENTIDAD_API_KEY=
IDENTIDAD_API_CLIENT_ID=colmapro
IDENTIDAD_API_TIMEOUT=12s
