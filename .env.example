# WAMERCIO - copia este archivo como .env en desarrollo.
# En Dokploy, define estas variables en la pestaña Environment.

POSTGRES_DB=wamercio
POSTGRES_USER=wamercio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgres://wamercio:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/wamercio?sslmode=disable
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_WEBHOOK_SECRET=CHANGE_ME_INTERNAL_WEBHOOK_SECRET
PLATFORM_CONFIG_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@wamercio.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Administrador WAMERCIO

APP_URL=https://wamercio.com
NEXT_PUBLIC_APP_URL=https://wamercio.com
PLATFORM_DOMAIN=wamercio.com
TENANT_ROOT_DOMAIN=ltd.do
CUSTOM_DOMAIN_CNAME_TARGET=domains.ltd.do
INTERNAL_API_URL=http://api:8080
API_PUBLIC_URL=https://wamercio.com

WHATSAPP_BRIDGE_URL=http://whatsapp:8090
WHATSAPP_DATABASE_URL=postgres://wamercio:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/wamercio?sslmode=disable
CORE_WEBHOOK_URL=http://api:8080

TZ=America/Santo_Domingo

# Conexiones sociales / Proxy Auth administrado por WAMERCIO.
# Los comercios NO configuran credenciales OAuth; solo presionan Conectar.
WAMERCIO_SOCIAL_AUTH_PROXY_ENABLED=true
WAMERCIO_SOCIAL_AUTH_PROXY_BASE_URL=https://auth-apps.bitapps.pro/apps
WAMERCIO_SOCIAL_AUTH_PROXY_REDIRECT_URI=https://auth-apps.bitapps.pro/redirect/v2
WAMERCIO_SOCIAL_PUBLISH_POLL_SECONDS=30

# Fallback opcional administrado por la plataforma si el Proxy Auth no está disponible.
# No exponer estas variables a los tenants ni al frontend.
WAMERCIO_SOCIAL_FACEBOOK_CLIENT_ID=
WAMERCIO_SOCIAL_FACEBOOK_CLIENT_SECRET=
WAMERCIO_SOCIAL_FACEBOOK_REDIRECT_URI=
WAMERCIO_SOCIAL_INSTAGRAM_CLIENT_ID=
WAMERCIO_SOCIAL_INSTAGRAM_CLIENT_SECRET=
WAMERCIO_SOCIAL_INSTAGRAM_REDIRECT_URI=
WAMERCIO_SOCIAL_LINKEDIN_CLIENT_ID=
WAMERCIO_SOCIAL_LINKEDIN_CLIENT_SECRET=
WAMERCIO_SOCIAL_LINKEDIN_REDIRECT_URI=
WAMERCIO_SOCIAL_GOOGLE_BUSINESS_CLIENT_ID=
WAMERCIO_SOCIAL_GOOGLE_BUSINESS_CLIENT_SECRET=
WAMERCIO_SOCIAL_GOOGLE_BUSINESS_REDIRECT_URI=

# Voz / transcripción. Compatible con endpoints multipart estilo OpenAI Whisper.
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# WAMERCIO Calls Premium. El transporte WACalls/WebRTC vive en un adaptador separado.
CALLS_ADAPTER_URL=
CALLS_ADAPTER_SECRET=
